{
  "name": "tgbuddy",
  "version": "0.1.0",
  "description": "精简版 Agent 桌面应用：Electron + React + pi 内核",
  "type": "module",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,green \"bun run dev:vite\" \"bun run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "bun run build:main && bun run build:preload && electron .",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=esm --packages=external --loader:.sql=text --outfile=dist/main.js --sourcemap",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "build:renderer": "vite build",
    "build": "bun run build:main && bun run build:preload && bun run build:renderer",
    "build:sqlite-spike": "esbuild scripts/sqlite-spike.ts scripts/sqlite-spike-main.ts --bundle --platform=node --format=esm --packages=external --loader:.sql=text --outdir=dist/sqlite-spike --sourcemap",
    "spike:sqlite": "bun run build:sqlite-spike && node dist/sqlite-spike/sqlite-spike.js",
    "probe": "bun run scripts/probe.ts",
    "probe:compaction": "bun run scripts/probe-compaction.ts",
    "test": "bun test",
    "test:e2e": "bun run build && playwright test",
    "check:architecture": "bun run scripts/check-architecture.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.82.1",
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-storage-sqlite-node": "0.82.1",
    "@streamdown/code": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^2.17.1",
    "lucide-react": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@electron/packager": "20.0.4",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "latest",
    "@types/node": "22.20.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^39.0.0",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0",
    "vite": "^6.0.3"
  }
}
